{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Security Research Assistant - Input Schema",
  "type": "object",
  "required": ["authorization", "artifacts"],
  "properties": {
    "authorization": {
      "type": "object",
      "description": "Required before any analysis runs. No authorization = halt.",
      "required": ["engagement_type", "scope_statement", "authorized_by"],
      "properties": {
        "engagement_type": {
          "type": "string",
          "enum": ["internal_pentest", "bug_bounty_program", "internal_code_review", "authorized_red_team"]
        },
        "program_or_ticket_reference": { "type": "string" },
        "scope_statement": {
          "type": "string",
          "description": "Free text describing in-scope domains/repos/systems"
        },
        "in_scope_assets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "out_of_scope_assets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "authorized_by": { "type": "string" },
        "engagement_dates": {
          "type": "object",
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_type", "content"],
        "properties": {
          "artifact_id": { "type": "string" },
          "artifact_type": {
            "type": "string",
            "enum": [
              "source_code", "http_request", "http_response", "headers",
              "cookies", "openapi_spec", "graphql_sdl", "js_bundle",
              "config_file", "dockerfile", "docker_compose", "kubernetes_manifest",
              "terraform", "ci_cd_config", "dependency_manifest", "robots_txt",
              "sitemap_xml", "security_report", "log_file", "stack_trace",
              "architecture_diagram"
            ]
          },
          "source_path_or_name": { "type": "string" },
          "content": { "type": "string", "description": "Raw text content, or description for diagrams" },
          "notes": { "type": "string" }
        }
      }
    },
    "focus_areas": {
      "type": "array",
      "description": "Optional - narrow analysis to specific OWASP categories/agents",
      "items": { "type": "string" }
    }
  }
}
